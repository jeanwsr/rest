[ctrl]
     # 设置程序输出的程度，缺省为1
     print_level =               1
     # 设置Rayon和OpenMP的并行数，缺省为1
     num_threads =               8
     # 设置使用的电子结构方法，缺省为HF
     xc =                        "pbe0"
     basis_path =                "def2-TZVP"
     auxbas_path =               "def2-TZVP-RIFIT"
     # 使用resolution-of-identity (RI)技术处理四中心积分（缺省）
     eri_type =                  "ri_v"
     #use_ri_vj =                 "false"
     use_ri_symm =               true
     charge =                    0.0
     spin =                      1.0
     spin_polarization =         false
     job_type =                  "freq"
     nhessian_displacement =     0.005

[geom]
     name = "C6H6"
     unit = "angstrom"
     position = '''
   C    0.000000   -2.643147   0.0
   C    2.289033   -1.321574   0.0
   C    2.289033    1.321574   0.0
   C    0.000000    2.643147   0.0
   C    -2.289033    1.321574   0.0
   C    -2.289033   -1.321574   0.0
   H    4.075004   -2.352703   0.0
